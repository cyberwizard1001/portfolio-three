---
import WindowChrome from './WindowChrome.astro';
---

<section class="hero-section grid-bg">
  <div class="hero-window">
    <WindowChrome title="bash —" activeTitle="~/portfolio/nirmal" icon="⌃⌥T">
      <div class="hero-win-body">
        <div class="hero-glow" id="hero-glow" aria-hidden="true"></div>
        <div class="hero-main">
          <div class="hero-copy">
            <p class="hero-prompt">
              <span class="ps1">nirmal@dev ~/portfolio $</span>&nbsp;cat about.txt<span class="cursor-blink"></span>
            </p>
            <h1 class="hero-h1">
              <span class="stroke">Less friction,</span><br />
              More clarity.<br />
              <span class="lime">Better</span><br />
              decisions.
            </h1>
          </div>
          <dl class="hero-meta">
            <div class="hm-row">
              <dt>role</dt>
              <dd>Product Designer</dd>
            </div>
            <div class="hm-row">
              <dt>focus</dt>
              <dd>Product design, research & design systems</dd>
            </div>
            <div class="hm-row">
              <dt>based</dt>
              <dd>United Kingdom (Remote-friendly)</dd>
            </div>
            <div class="hm-row">
              <dt>status</dt>
              <dd><span class="hm-dot"></span>Open for collaboration</dd>
            </div>
          </dl>
        </div>
      </div>
    </WindowChrome>
  </div>
</section>

<style>
  .hero-section {
    height: calc(100vh - var(--bar-h));
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }

  .hero-window {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
    height: calc(100vh - var(--bar-h) - 2rem);
    display: flex;
    flex-direction: column;
  }

  .hero-window :global(.window) {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .hero-win-body {
    background: var(--term-overlay);
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.6s;
    z-index: 0;
  }
  .hero-win-body:hover .hero-glow { opacity: 1; }

  .hero-main {
    flex: 1;
    padding: 2.5rem 2.5rem 2rem;
    display: grid;
    position: relative;
    z-index: 1;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 2rem;
  }

  .hero-copy { min-width: 0; }

  .hero-meta {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding-left: 2rem;
    border-left: 1px solid var(--border);
    margin: 0;
    min-width: 220px;
  }

  .hm-row dt {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }

  .hm-row dd {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--sub);
    margin: 0;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hm-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px var(--lime-dim);
  }

  @media (max-width: 1024px) {
    .hero-main {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero-meta {
      padding-left: 0;
      border-left: none;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem 2rem;
    }
  }

  .hero-prompt {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--lime);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-prompt .ps1 { color: var(--dim); }

  .hero-h1 {
    font-family: var(--mono);
    font-size: clamp(3.5rem, 8.5vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.9;
    color: var(--text);
    margin-bottom: 0;
  }

  .hero-h1 .stroke {
    -webkit-text-stroke: 1.5px var(--dim);
    color: transparent;
  }

  .hero-h1 .lime { color: var(--lime); }

  @media (max-width: 860px) {
    .hero-section {
      height: auto;
      min-height: calc(100vh - var(--bar-h));
      padding: 1.25rem;
    }
    .hero-window { height: auto; }
  }

  @media (max-width: 480px) {
    .hero-h1 { font-size: clamp(2.25rem, 11vw, 3rem); }
    .hero-main { padding: 1.25rem; }
    .hero-prompt { margin-bottom: 1rem; }
    .hero-meta { gap: 1rem; }
  }

  @media (max-width: 860px) {
    .hero-glow { display: none; }
  }
</style>

<script>
  (function heroSpotlight() {
    const winBody = document.querySelector('.hero-win-body') as HTMLElement;
    const glow = document.getElementById('hero-glow') as HTMLElement;
    if (!winBody || !glow) return;

    function getCSSVar(name: string) {
      return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    }

    function hexToRgba(hex: string, a: number) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r},${g},${b},${a})`;
    }

    function updateGlow() {
      const lime = getCSSVar('--lime');
      if (lime.startsWith('#')) {
        glow.style.background = `radial-gradient(circle, ${hexToRgba(lime, 0.12)} 0%, ${hexToRgba(lime, 0.04)} 40%, transparent 65%)`;
      }
    }

    winBody.addEventListener('mousemove', (e) => {
      const rect = winBody.getBoundingClientRect();
      glow.style.left = (e.clientX - rect.left) + 'px';
      glow.style.top = (e.clientY - rect.top) + 'px';
      updateGlow();
    });

    new MutationObserver(updateGlow).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'data-mode'],
    });

    updateGlow();
  })();
</script>
