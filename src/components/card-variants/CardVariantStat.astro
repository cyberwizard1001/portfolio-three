---
// Variant D — "Stat": image left, text right, outcome broken out into a bordered stat tile.
// Emphasises the metric as the visual anchor.
interface Props {
  href: string;
  eyebrow: string;
  title: string;
  problem: string;
  outcomeValue: string;
  outcomeLabel: string;
  image: string;
  imageAlt: string;
}
const { href, eyebrow, title, problem, outcomeValue, outcomeLabel, image, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a class="st" href={href}>
  <div class="st-image">
    <img src={`${base}${image.replace(/^\//, '')}`} alt={imageAlt} />
  </div>
  <div class="st-text">
    <span class="st-eyebrow">{eyebrow}</span>
    <h3 class="st-title">{title}</h3>
    <p class="st-problem">{problem}</p>
    <div class="st-footer">
      <div class="st-tile">
        <span class="st-value">{outcomeValue}</span>
        <span class="st-label">{outcomeLabel}</span>
      </div>
      <span class="st-cta">Open case study <span class="st-arr">→</span></span>
    </div>
  </div>
</a>

<style>
  .st {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 0;
    background: var(--bg1);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.18s;
  }
  .st:hover { border-color: var(--lime); }
  .st-image { background: var(--term-bg); overflow: hidden; }
  .st-image img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.4s ease;
  }
  .st:hover .st-image img { transform: scale(1.03); }
  .st-text { padding: 2rem; display: flex; flex-direction: column; }
  .st-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.9rem;
  }
  .st-title {
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text);
    margin: 0 0 0.85rem;
  }
  .st-problem {
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--sub);
    margin: 0 0 1.5rem;
    flex: 1;
  }
  .st-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .st-tile {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.9rem;
    background: var(--lime-dim);
  }
  .st-value {
    font-family: var(--mono);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--lime);
  }
  .st-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--dim);
    margin-top: 0.35rem;
    max-width: 22ch;
  }
  .st-cta {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .st-arr { transition: transform 0.18s; }
  .st:hover .st-arr { transform: translateX(3px); }

  @media (max-width: 860px) {
    .st { grid-template-columns: 1fr; }
    .st-image { aspect-ratio: 16 / 9; }
    .st-footer { flex-direction: column; align-items: flex-start; }
  }
</style>
