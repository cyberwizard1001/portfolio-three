---
// Variant B — "Window": reference content inside the site's vim window chrome.
// card-bar (traffic lights + vim:filename) on top, vim statusline footer, problem→outcome split body.
interface Props {
  href: string;
  filename: string;
  eyebrow: string;
  title: string;
  problem: string;
  outcomeValue: string;
  outcomeLabel: string;
  image: string;
  imageAlt: string;
}
const { href, filename, eyebrow, title, problem, outcomeValue, outcomeLabel, image, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a class="card-window wv" href={href}>
  <div class="card-bar">
    <div class="card-controls">
      <div class="card-ctrl"></div><div class="card-ctrl"></div><div class="card-ctrl"></div>
    </div>
    <span class="card-bar-title">vim: <span class="fname">{filename}</span></span>
  </div>

  <div class="wv-body">
    <div class="wv-text">
      <span class="wv-eyebrow">{eyebrow}</span>
      <h3 class="wv-title">{title}</h3>
      <p class="wv-problem">{problem}</p>
      <div class="wv-outcome">
        <span class="wv-value">{outcomeValue}</span>
        <span class="wv-label">{outcomeLabel}</span>
      </div>
    </div>
    <div class="wv-image">
      <img src={`${base}${image.replace(/^\//, '')}`} alt={imageAlt} />
    </div>
  </div>

  <div class="wv-statusline">
    <span class="wv-sl-mode">NORMAL</span>
    <span class="wv-sl-file">{filename}</span>
    <span class="wv-sl-spacer"></span>
    <span class="wv-sl-cta">open case study <span class="wv-arr">↗</span></span>
  </div>
</a>

<style>
  .wv { display: flex; flex-direction: column; text-decoration: none; }
  .wv-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: center;
    background: var(--bg1);
    padding: 1.75rem;
  }
  .wv-text { display: flex; flex-direction: column; }
  .wv-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 0.9rem;
  }
  .wv-title {
    font-family: var(--mono);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--text);
    margin: 0 0 0.75rem;
  }
  .wv-problem {
    font-family: var(--mono);
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--sub);
    margin: 0 0 1.5rem;
  }
  .wv-outcome {
    display: flex;
    flex-direction: column;
    border-left: 2px solid var(--lime);
    padding-left: 0.9rem;
  }
  .wv-value {
    font-family: var(--mono);
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--lime);
  }
  .wv-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--dim);
    margin-top: 0.4rem;
  }
  .wv-image {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--term-bg);
    aspect-ratio: 4 / 3;
  }
  .wv-image img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    opacity: 0.9; mix-blend-mode: luminosity;
    transition: transform 0.4s ease;
  }
  .wv:hover .wv-image img { transform: scale(1.02); }

  .wv-statusline {
    display: flex;
    align-items: center;
    gap: 0;
    font-family: var(--mono);
    font-size: 11px;
    background: var(--lime);
    color: var(--bg1);
    height: 26px;
  }
  .wv-sl-mode { font-weight: 700; padding: 0 0.75rem; height: 100%; display: flex; align-items: center; background: color-mix(in srgb, var(--bg1) 18%, var(--lime)); }
  .wv-sl-file { padding: 0 0.75rem; opacity: 0.85; }
  .wv-sl-spacer { flex: 1; }
  .wv-sl-cta { padding: 0 0.75rem; font-weight: 600; display: flex; align-items: center; gap: 0.35rem; }
  .wv-arr { transition: transform 0.18s; }
  .wv:hover .wv-arr { transform: translate(2px, -2px); }

  @media (max-width: 860px) {
    .wv-body { grid-template-columns: 1fr; gap: 1.25rem; }
    .wv-image { order: -1; }
  }
</style>
