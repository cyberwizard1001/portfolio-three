---
import Layout from '../layouts/Layout.astro';
import Waybar from '../components/Waybar.astro';
import Footer from '../components/Footer.astro';
import CardVariantHorizon from '../components/card-variants/CardVariantHorizon.astro';
import CardVariantWindow from '../components/card-variants/CardVariantWindow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CardVariantStat from '../components/card-variants/CardVariantStat.astro';

const base = import.meta.env.BASE_URL;

// Real project data, mapped into problem→outcome shape for preview.
const samples = [
  {
    href: `${base}projects/perro-onboarding/`,
    filename: 'perro-onboarding.md',
    eyebrow: 'Mobile App · Onboarding · End-to-End',
    title: 'Perro Onboarding',
    problem:
      'People install apps and forget they exist. Perro’s onboarding stalled at photo and health bottlenecks, so new users dropped before reaching their first real in-app action.',
    outcomeValue: '↑ Conversion',
    outcomeLabel: 'Higher subscription take-up after launch — UX cited as a product strength during acquisition.',
    image: '/images/perro/hero.svg',
    imageAlt: 'Perro onboarding flow screens',
  },
  {
    href: `${base}projects/pet-insurance-checkout/`,
    filename: 'pet-insurance-checkout.md',
    eyebrow: 'Web · Checkout · Conversion',
    title: 'Pet Insurance Checkout',
    problem:
      'The review page buried the numbers that mattered and left claim terms ambiguous, slowing time-to-decision and seeding post-sale disputes.',
    outcomeValue: 'A/B live',
    outcomeLabel: '4 variants live in Amplitude with real traffic, measuring quote-completion uplift.',
    image: '/images/pet-insurance/hero.svg',
    imageAlt: 'Pet insurance checkout review screen',
  },
  {
    href: `${base}projects/counselling-companions/`,
    filename: 'counselling-companions.md',
    eyebrow: 'UX Research · MSc Dissertation · 0→1',
    title: 'Crafting Counselling Companions',
    problem:
      'Solo counsellors lose 15–20 minutes of every 40-minute session to admin borrowed from tools never built for their work.',
    outcomeValue: '7 themes',
    outcomeLabel: 'From 7 practitioner interviews and 47 codes — shaping a purpose-built concept tool.',
    image: '/images/counselling/hero.svg',
    imageAlt: 'Session time shifting from admin to client practice',
  },
];
---

<Layout title="Card variants — Nirmal">
  <Waybar />
  <main id="main-content" class="cv-page">
    <header class="cv-head">
      <span class="cv-label">card_variants</span>
      <p class="cv-note">
        Preview of problem→outcome project cards. Same 3 real projects rendered 4 ways. Pick one and
        I’ll wire it into the home page.
      </p>
    </header>

    <section class="cv-set">
      <h2 class="cv-h2"><span class="cv-tag">A</span> Horizon — faithful clone of the reference</h2>
      <div class="cv-stack">
        {samples.map((s) => <CardVariantHorizon {...s} />)}
      </div>
    </section>

    <section class="cv-set">
      <h2 class="cv-h2"><span class="cv-tag">B</span> Window — reference content in vim window chrome</h2>
      <div class="cv-stack">
        {samples.map((s) => <CardVariantWindow {...s} />)}
      </div>
    </section>

    <section class="cv-set">
      <h2 class="cv-h2"><span class="cv-tag">C</span> Diff — portrait card, problem as −, outcome as +</h2>
      <div class="cv-grid3">
        {samples.map((s) => <ProjectCard {...s} year="2025" />)}
      </div>
    </section>

    <section class="cv-set">
      <h2 class="cv-h2"><span class="cv-tag">D</span> Stat — image left, outcome as a stat tile</h2>
      <div class="cv-stack">
        {samples.map((s) => <CardVariantStat {...s} />)}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .cv-page { max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
  .cv-head { margin-bottom: 3rem; }
  .cv-label {
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }
  .cv-note {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--sub);
    line-height: 1.6;
    max-width: 60ch;
    margin: 0.75rem 0 0;
  }
  .cv-set { margin-bottom: 3.5rem; }
  .cv-h2 {
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--text);
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
  }
  .cv-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--lime);
    color: var(--bg1);
    font-weight: 800;
    font-size: 0.8rem;
  }
  .cv-stack { display: flex; flex-direction: column; gap: 1.5rem; }
  .cv-grid3 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; align-items: stretch; }
  @media (max-width: 860px) { .cv-grid3 { grid-template-columns: 1fr; } }
</style>
